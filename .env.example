# ─────────────────────────────────────────────────────────
# EU AI Act Risk Classifier — local environment example
# Copy to .env and adjust for local development.
# ─────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Postgres (primary DB + audit log partition) ──
DATABASE_URL=postgres://classifier:classifier@localhost:5432/classifier
AUDIT_DATABASE_URL=postgres://audit:audit@localhost:5432/audit

# ── Redis (cache, queues) ──
REDIS_URL=redis://localhost:6379

# ── OPA (rules engine) ──
OPA_URL=http://localhost:8181

# ── S3 / MinIO (document store) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=classifier-docs
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── Auth ──
JWT_ISSUER=https://auth.local.eu-ai-act.dev
JWT_AUDIENCE=eu-ai-act-classifier
JWT_JWKS_URL=http://localhost:4444/.well-known/jwks.json
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Service ports (local dev) ──
PORT_GATEWAY=4000
PORT_CLASSIFICATION=4001
PORT_WORKFLOW=4002
PORT_REGULATORY=4003
PORT_TIMELINE=4004
PORT_AUDIT=4005
PORT_NOTIFICATION=4006
PORT_TENANT=4007
PORT_EXPORT=4008
PORT_WEB=3000

# ── Inter-service URLs (consumed by api-gateway and service-to-service calls) ──
CLASSIFICATION_URL=http://localhost:4001
WORKFLOW_URL=http://localhost:4002
REGULATORY_URL=http://localhost:4003
TIMELINE_URL=http://localhost:4004
AUDIT_LOG_URL=http://localhost:4005
NOTIFICATION_URL=http://localhost:4006
TENANT_URL=http://localhost:4007
EXPORT_URL=http://localhost:4008

# ── API Gateway (ADR 0001) ──
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ── Email (Mailhog locally) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="EU AI Act Classifier <noreply@local.eu-ai-act.dev>"
NOTIFY_REVIEWER_EMAIL=reviewers@local.eu-ai-act.dev
NOTIFY_REVIEWER_LEGAL_EMAIL=legal-reviewers@local.eu-ai-act.dev
NOTIFY_REVIEWER_GOVERNANCE_EMAIL=governance-reviewers@local.eu-ai-act.dev

# ── Export storage (local dev; replace with S3-backed storage in production) ──
EXPORT_STORAGE_DIR=generated/exports

# ── Rules content ──
RULES_DIR=./rules
RULES_ACTIVE_VERSION=v1

# ── Observability ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=eu-ai-act
