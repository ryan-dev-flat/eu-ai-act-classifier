{
  "name": "eu-ai-act-classifier",
  "version": "0.1.0",
  "private": true,
  "description": "EU AI Act Risk Classifier — multi-tenant SaaS platform (MVP).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --parallel run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r --parallel run lint",
    "test": "pnpm -r --parallel run test",
    "typecheck": "pnpm -r --parallel run typecheck",
    "db:migrate": "pnpm --filter @eu-ai-act/db run migrate",
    "db:seed": "pnpm --filter @eu-ai-act/db run seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down -v",
    "gateway:up": "docker compose --profile gateway up -d --build api-gateway",
    "gateway:down": "docker compose --profile gateway rm -sf api-gateway",
    "gateway:logs": "docker compose --profile gateway logs -f api-gateway"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "prettier": "^3.3.3",
    "turbo": "^2.9.14",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "react-hook-form": "7.50.1"
    }
  }
}
