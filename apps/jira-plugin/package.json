    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@forge/api": "^4.2.0",
    "@forge/bridge": "^4.4.0",
    "@forge/react": "^10.10.0",
    "@forge/resolver": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.6.3"
  }
}
